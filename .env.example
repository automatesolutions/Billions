# Backend (FastAPI). Copy to .env in the repo root.

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Defaults to SQLite at ./data/billions.db. Postgres works too.
# DATABASE_URL=sqlite:///./data/billions.db

# Optional. Leave empty to use the free NASDAQ Trader symbol list.
ALPHA_VANTAGE_API_KEY=

# Optional. Free Alpaca keys (https://alpaca.markets, paper account) turn on live
# best bid/ask quotes in the Microstructure panel. The free feed is IEX only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

DEBUG=false

# Background outlier refresh (on by default) and its interval while the market is open.
# OUTLIER_SCHEDULER=true
# REFRESH_INTERVAL_MINUTES=30
