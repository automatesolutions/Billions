# Backend (FastAPI). Copy to .env in the repo root.

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Defaults to SQLite at ./data/billions.db. Postgres works too.
# DATABASE_URL=sqlite:///./data/billions.db

# Optional. Leave empty to use the free NASDAQ Trader symbol list.
ALPHA_VANTAGE_API_KEY=

# Optional. Free Alpaca keys (https://alpaca.markets, paper account) turn on live
# best bid/ask quotes in the Microstructure panel. The free feed is IEX only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading bot. The same Alpaca keys place paper orders here. Only the paper
# endpoint is accepted; the bot refuses to start with any other URL.
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Optional. Polygon.io key (https://polygon.io) for bars used by the bot and lead-lag
# research. The free plan allows 5 requests per minute and its data is delayed.
POLYGON_API_KEY=
# POLYGON_URL=https://api.polygon.io
# Turn these on only if your Polygon plan includes them. The free plan has neither.
# POLYGON_SECOND_BARS=false
# POLYGON_REALTIME=false

# Paper bot. Off by default. Set a long random BOT_ADMIN_TOKEN whenever anyone but
# you can reach the API; the Bot page then asks for it.
# BOT_ENABLED=false
# BOT_ADMIN_TOKEN=
# BOT_MAX_POSITION_DOLLARS=1000
# BOT_MAX_ORDERS_PER_DAY=20

# Lead-lag research: daily rescan after the close, data source (polygon or alpaca), history.
# LEAD_LAG_SCHEDULER=true
# LEAD_LAG_SOURCE=polygon
# LEAD_LAG_DAYS=60

DEBUG=false

# Background outlier refresh (on by default) and its interval while the market is open.
# OUTLIER_SCHEDULER=true
# REFRESH_INTERVAL_MINUTES=30
