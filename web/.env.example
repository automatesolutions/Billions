# Frontend (Next.js). Copy to web/.env.local.

# Base URL of the FastAPI backend, as the browser sees it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: URL the Next.js server uses to reach the API (e.g. a private network name).
# Defaults to NEXT_PUBLIC_API_URL.
# API_URL=http://api:8000

# Public URL of this site, used for canonical links and Open Graph previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
